# Non-secret Economy AI runtime profile. Do not commit API keys.
ECONOMY_AI_API_BASE_URL=http://127.0.0.1:11434/v1
ECONOMY_AI_MODEL_A=llama3.2:3b
ECONOMY_AI_MODEL_B=gemma3:1b
ECONOMY_AI_MAX_CONCURRENCY=1
ECONOMY_AI_TIMEOUT_MS=180000
ECONOMY_AI_CACHE_TTL_SECONDS=300
ECONOMY_AI_REVIEW_TTL_MINUTES=120
# Automatic fictional stock scenarios; disabled unless explicitly enabled.
AI_NEWS_AUTO_ENABLED=false
AI_NEWS_AUTO_ACTOR_USER_ID=
# Optional deployment-owned OpenAI-compatible endpoint for unattended stock news.
# When set with AI_NEWS_AUTO_MODEL, automatic generation does not depend on a
# human operator's encrypted newsroom API key. Leave API key empty for local Ollama.
AI_NEWS_AUTO_API_BASE_URL=http://127.0.0.1:11434/v1
AI_NEWS_AUTO_MODEL=llama3.2:3b
AI_NEWS_AUTO_API_KEY=
