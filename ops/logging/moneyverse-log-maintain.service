[Unit]
Description=Compress verified closed Moneyverse log segments and enforce UTC 7/30-day expiry
After=moneyverse-log-collect.service

[Service]
Type=oneshot
User=root
Group=moneyverse-logread
UMask=0027
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/libexec/moneyverse-log-lifecycle.py --root /var/lib/moneyverse/log-archive maintain
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/moneyverse/log-archive
MemoryMax=384M
TasksMax=40
