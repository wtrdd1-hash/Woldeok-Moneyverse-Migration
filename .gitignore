node_modules/
.pnpm-store/

# Build output
dist/
/build/
.next/
out/
*.tsbuildinfo

# Generated
packages/database/prisma/generated/
packages/contract/src/generated/

# Environment — real values never enter Git
.env
.env.*
!.env.example

# Test and tooling artifacts
coverage/
.vitest/
playwright-report/
test-results/
.eslintcache

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code local state: agent worktrees and machine-local settings
.claude/

# Backend runtime data — code/schema stay in Git, real data never does
backend/data/
backend/storage/
backend/uploads/
backend/backups/
backups/

# Database dumps and local database files
*.dump
*.dump.gz
*.backup
*.backup.gz
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.sql.zst
*.sql.xz

# Backend exports and runtime logs
backend/**/*.csv
backend/**/*.jsonl
backend/**/*.ndjson
backend/**/*.log
backend/**/*.bak

# Large generated datasets
frontend/src/lib/i18n/references/corpus-150k.json

# Sensitive scripts, certificates, and operational tools (NEVER in Git)
*.sh
!packages/database/init/000-create-app-role.sh
*.bash
stage_*.sh
promote_*.sh
smoke_*.sh
deploy/
ops/backup/*.sh
ops/nginx/*.sh
ops/recovery/
ops/release/*.sh
ops/systemd/*.sh
scripts/qa/*.sh

# Certificates, private keys, secrets
*.pem
*.key
*.crt
*.cer
*.pfx
*.p12
*.id_rsa

# Public-repository boundary: internal records stay in approved private storage
docs/updates/*-internal*.md
docs/internal/
.internal/
