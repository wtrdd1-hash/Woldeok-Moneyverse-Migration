{
  "name": "woldeok-moneyverse",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm --filter @moneyverse/contract build && pnpm -r --sequential typecheck",
    "test": "pnpm --filter @moneyverse/contract build && pnpm -r --sequential test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "16.3.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "qs": ">=6.16.0",
      "multer": ">=2.3.0"
    }
  }
}
