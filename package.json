{
  "name": "woldeok-moneyverse",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm --filter @moneyverse/contract build && pnpm -r --sequential typecheck",
    "test": "pnpm --filter @moneyverse/contract build && pnpm -r --sequential test",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.24",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "qs": ">=6.16.0"
    }
  }
}
