# This service must only listen on a host loopback address. Do not use 0.0.0.0.
MINECRAFT_AGENT_HOST=127.0.0.1
MINECRAFT_AGENT_PORT=18080

# Generate a unique high-entropy token, for example:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
MINECRAFT_AGENT_TOKEN=REPLACE_WITH_A_32_BYTE_OR_LONGER_RANDOM_TOKEN

# The target is selected only from this server-side allowlist. It is never read
# from an HTTP request.
MINECRAFT_SYSTEMD_SERVICE=minecraft-server.service
MINECRAFT_ALLOWED_SYSTEMD_SERVICES=minecraft-server.service

# Conservative anti-abuse limits.
MINECRAFT_AGENT_RATE_LIMIT_MAX=30
MINECRAFT_AGENT_RATE_LIMIT_WINDOW_MS=60000
MINECRAFT_AGENT_MUTATION_COOLDOWN_MS=3000
MINECRAFT_AGENT_COMMAND_TIMEOUT_MS=20000
MINECRAFT_AGENT_LOG_TIMEOUT_MS=10000
MINECRAFT_AGENT_LOG_LINES=200
