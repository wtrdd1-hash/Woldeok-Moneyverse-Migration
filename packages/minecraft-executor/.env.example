# This worker is host-local. It is not a web service and must never use the
# web application's moneyverse_app role or the migration-owner role.
#
# Provision a separate LOGIN principal outside Git, grant it membership in the
# NOLOGIN moneyverse_minecraft_executor role from migration 017, and use its
# connection string here. Replace every placeholder before use.
MINECRAFT_EXECUTOR_DATABASE_URL=postgresql://moneyverse_minecraft_executor_login:REPLACE_WITH_A_SECRET@127.0.0.1:5432/woldeok_moneyverse
MINECRAFT_EXECUTOR_DB_ROLE=moneyverse_minecraft_executor

# Exact literal loopback origin of minecraft-agent. Do not use localhost,
# Docker bridge addresses, a reverse proxy, a tunnel, or a public address.
MINECRAFT_AGENT_ENDPOINT=http://127.0.0.1:18080
MINECRAFT_AGENT_TOKEN=REPLACE_WITH_THE_MATCHING_32_BYTE_OR_LONGER_AGENT_TOKEN

# A claimed operation has a single lease and is never retried automatically.
# Leave enough time for the host-agent request and the DB completion receipt.
MINECRAFT_EXECUTOR_LEASE_SECONDS=60
MINECRAFT_EXECUTOR_AGENT_TIMEOUT_MS=25000
MINECRAFT_EXECUTOR_POLL_INTERVAL_MS=3000
MINECRAFT_EXECUTOR_AGENT_MAX_RESPONSE_BYTES=131072
